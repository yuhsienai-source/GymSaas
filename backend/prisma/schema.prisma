  trainer     Trainer? @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  /// PRIVATE | GROUP
  courseKind  String   @default("PRIVATE")
  /// PERFORMANCE | HOURLY | PER_HEAD
  payModel    String   @default("PERFORMANCE")
  baseSalary  Float    @default(0)
  /// 階段百分比 JSON：[{ minRevenue, rate }]
  tierRates   Json?
  /// 固定鐘點費（HOURLY）
  hourlyRate  Float?
  /// 人頭抽成（PER_HEAD）
  perHeadRate Float?
  /// 扣除：刷卡手續費率、發票稅率等
  deductRates Json?
  /// 考核分數影響係數
  scoreFactor Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([trainerId, courseKind])
}

model CoachCommissionLedger {
