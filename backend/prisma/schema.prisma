/// 乙禾端末成功暫存（confirm 前斷線 → 日結對帳）
model YipayTerminalCapture {
  id          String    @id // YCAP…
  /// ORDER | SALE | CHECKOUT
  targetType  String
  targetId    String
  amount      Float
  rrn         String?
  authCode    String?
  cardLast4   String?
  branchId    Int?
  staffId     Int?
  terminalRef String?
  /// PENDING_CONFIRM | CONFIRMED | ORPHAN | VOIDED
  status      String    @default("PENDING_CONFIRM")
  raw         Json?
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([rrn])
  @@index([branchId, createdAt])
}

/// ezPay 開票非同步任務（分腿可重試；CHK 開票失敗不沖回已收款）
model InvoiceIssueJob {
  id            String   @id @default(cuid())
  /// CHECKOUT | ORDER | SALE
  refType       String
  /// CHK… / TYK… / SAL… / CRS…
  refId         String
  /// SALE | PROMO | PT | ORDER | ALL
  leg           String
  amount        Float
  itemDesc      String
  buyerName     String?
  carrierNum    String?
  buyerUbn      String?
  loveCode      String?
  /// 來源合併結帳（稽核／回寫 SPLIT）
  checkoutId    String?
  /// PENDING | SUCCESS | FAILED
  status        String   @default("PENDING")
  retryCount    Int      @default(0)
  lastError     String?
  invoiceNumber String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([refId, leg])
  @@index([status, retryCount])
  @@index([refId])
  @@index([checkoutId, status])
}

