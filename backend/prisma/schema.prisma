// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 最新規範：這裡不再放網址
datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. 企業連鎖核心：分店與場地
// ==========================================
model Branch {
  id          Int       @id @default(autoincrement())
  name        String    @unique // 正式名稱（會員介面顯示）如: "和平店"
  /// 員工端關聯顯示用代碼（如 HP）；會員介面仍用 name
  code        String?   @unique
  /// 分店類型：GYM 健身房／CLASS 教室／ACADEMY 學院（規則見 lib/orgStructure.js）
  type        String    @default("GYM")
  /// 隸屬上層分店（僅一層：CLASS → GYM）
  parentId    Int?
  parent      Branch?   @relation("BranchHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Branch[]  @relation("BranchHierarchy")
  rosterConfig  BranchRosterConfig?
  rosterPeriods RosterPeriod[]
  rosterOffRequests RosterOffRequest[]
  address     String?     // 👈 補上這個欄位 (加上 ? 代表允許為空，避免影響舊資料)
  /// 場館介紹（文字）
  introText   String?     @db.Text
  /// 場館介紹圖片 URL 陣列
  introImages Json?
  /// 場館介紹影片 URL 陣列
  introVideos Json?
  /// 是否對外顯示即時人數
  showOccupancy Boolean   @default(true)
  /// 所屬營業人（獨立統編／ezPay 商店）；發票、進貨、應付皆歸此營業人
  legalEntityId Int?
  legalEntity   LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  isActive    Boolean   @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  // 該分店專屬的促銷方案與場地
  promotions  Promotion[]
  coursePlans CoursePlan[]
  venues      Venue[]
  
  // 該分店有哪些教練有權限開課
  trainers    TrainerBranch[]

  // 進銷存
  stocks          BranchStock[]
  stockMovements  StockMovement[]
  purchaseOrders  PurchaseOrder[]
  purchaseReceipts PurchaseReceipt[]
  orders          Order[]
  saleOrders      SaleOrder[]
  checkoutSessions CheckoutSession[]
  shiftHandovers  ShiftHandover[]
  checkInLogs     CheckInLog[]

  // 綁定本分店的員工
  staffMembers    Staff[]
  ptContracts     PTContract[]
  memberBranches  MemberBranch[]
  gateDevices     GateDevice[]
  announcements   Announcement[]
  faqItems        FaqItem[]
  memberGroups    MemberGroup[]

  @@index([parentId])
  @@index([legalEntityId])
}

/// 營業人：獨立統編＝獨立 ezPay 商店。HashKey／HashIV 只在 env（EZPAY_{code}_HASH_KEY／_HASH_IV），禁止入庫
model LegalEntity {
  id              Int      @id @default(autoincrement())
  /// env 前綴（大寫英數，如 HP）
  code            String   @unique
  /// 營業人名稱（發票／折讓單抬頭）
  name            String
  /// 統一編號 8 碼
  ubn             String   @unique
  address         String?
  phone           String?
  /// ezPay 商店代號（MerchantID，非機密）
  ezpayMerchantId String?  @unique
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branches         Branch[]
  einvoices        EInvoice[]
  allowances       InvoiceAllowance[]
  saleOrders       SaleOrder[]
  purchaseOrders   PurchaseOrder[]
  purchaseReceipts PurchaseReceipt[]
  payables         SupplierPayable[]
  supplierPayments SupplierPayment[]
}

model Venue {
  id       Int    @id @default(autoincrement())
  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name     String // 如: "A區VIP室", "草皮區"

  // 關聯：在該場地舉辦的課程、可細分站點（A~E、外區等）
  classes     Class[]
  classSeries ClassSeries[]
  stations    VenueStation[]
  bookings    VenueBooking[]
}

// 場地站點：教練排課時可再選細項訓練位置
model VenueStation {
  id        Int    @id @default(autoincrement())
  venueId   Int
  venue     Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name      String // 如: "A", "B", "外區"
  sortOrder Int    @default(0)

  classes     Class[]
  classSeries ClassSeries[]

  @@unique([venueId, name])
  @@index([venueId])
}

// ==========================================
// 2. 會員主表
// ==========================================
model Member {
  // 內部主鍵（關聯／JWT 用）；對外請顯示 memberNo
  id         Int      @id @default(autoincrement())

  // 對外會員編號（隨機 6 碼大寫英數，如 A3K9XZ）；舊資料可由 backfill 補齊
  memberNo   String?  @unique
  
  // name 欄位，型態是字串 (String)
  name       String

  // 基礎聯絡資訊：電話號碼作為系統唯一識別基準 (合併帳號用)
  phone           String       @unique

  // 緊急聯絡人（臨櫃編輯）
  emergencyContact      String?
  emergencyContactPhone String?

  role            String    @default("MEMBER")
  
  // plan：未購方案預設分鐘計費（計時會員）；購買完成後由金流／商品流程寫入
  plan       String   @default("計時會員")

  // expireDate 方案到期日。加問號 (?) 代表可以為空
  expireDate DateTime?

  /// 請假結束時間；非空且 now < leaveUntil → 禁止以無限／月費通行進場（效期已於請假開始時預先順延）
  leaveUntil DateTime?

  /// 真金白銀（DB CHECK >= 0；見 prisma/sql/gate_concurrency.sql）
  cashWallet  Float          @default(0.0)
  /// 贈送運動金（DB CHECK >= 0）
  bonusWallet Float          @default(0.0)

  // 【新增】防弊與社群登入綁定
  lineId          String?      @unique // LINE 唯一授權碼 (可選綁定)
  deviceId        String?      // 綁定的手機裝置碼 (一機一帳號防借用)
  /// 裝置綁定世代：每次綁定／解除／改綁遞增；JWT 須帶相同值，否則舊票立即失效
  deviceAuthVersion Int        @default(0)
  allowBiometrics Boolean      @default(false) // 快取：是否已簽目前版生物辨識同意書（以合約簽署為準）
  /// 櫃檯勾選「啟用人臉辨識」；為 true 時生物辨識同意書才標為必簽（紅）
  faceEnabled     Boolean      @default(false)
  /// 會員已於自助／櫃檯回答過是否啟用人臉（舊會員登入須先回答才進綁定）
  facePreferenceSet Boolean    @default(false)
  papagoFaceId    String?      @unique // PAPAGO Face8 人臉特徵 ID (臨櫃註冊綁定)
  /// 警示帳號 (防弊：若為 true 則強制人工查驗)
  isAlert         Boolean      @default(false) // 警示帳號 (防弊：若為 true 則強制人工查驗)

  email           String?
  /// 身分證／居留證／護照（開卡／自助註冊必填；舊資料可空。外國客可填居留證或護照）
  idNumber        String?      @unique
  /// M | F | OTHER
  gender          String?
  birthDate       DateTime?
  /// 證件正面照片 API 路徑標記（實際檔在 uploads/id-photos）
  idPhotoUrl      String?
  /// 證件反面照片 API 路徑標記
  idPhotoBackUrl  String?
  /// 團體課點數課餘額
  pointsBalance   Int          @default(0)

  // createdAt 欄位，型態是時間。紀錄這個會員是什麼時候建立的。
  // @default(now()) 會在資料寫入的瞬間，自動抓取當下的時間，這是現代 SaaS 系統的標配欄位。
  createdAt  DateTime @default(now())

  // 建立關聯：一個會員可以擁有「多個」進出場紀錄
  checkInLogs     CheckInLog[]
  reservations    Reservation[]
  consultGuests   ConsultGuest[]
  
  // 【4.0 新增】會員名下的私教合約
  ptContracts     PTContract[]
  orders Order[]
  saleOrders      SaleOrder[]
  checkoutSessions CheckoutSession[]
  cardSubscriptions CardSubscription[]
  memberLeaves      MemberLeave[]
  contractSignatures MemberContractSignature[]
  phoneOtps         PhoneOtp[]
  emailOtps         EmailOtp[]
  deviceAuditLogs   MemberDeviceAuditLog[]
  /// 會員綁定分店（進出場須符合綁定場館；AC↔HP 可互進）
  branches          MemberBranch[]
  /// 總部合規補償異動日誌
  hqCompensationLogs HqCompensationLog[]
  memberGroupMembers MemberGroupMember[]
  memberNotes        MemberNote[]
  classLeaves        ClassLeave[]
  makeupRegistrations MakeupRegistration[]
  trainingRecords    TrainingRecord[]
  selfTrainingPlans  SelfTrainingPlan[]
  venueBookings      VenueBooking[]
  familyCardMembers  FamilyCardMember[]
  memberPointsLedger MemberPointsLedger[]
  groupEnrollments   GroupEnrollment[]
  groupWaitlist      GroupWaitlist[]
  groupMakeupCredits GroupMakeupCredit[]
  lotteryEntries     LotteryEntry[]
  inBodyVouchers     InBodyVoucher[]
  giftCardsPurchased GiftCard[] @relation("GiftCardPurchaser")
  giftCardsRedeemed  GiftCard[] @relation("GiftCardRedeemer")
  paymentBlacklist   PaymentBlacklist?
  notificationLogs   NotificationLog[]
  classAttendances   ClassAttendance[]
  idPhotos           MemberIdPhoto[]
  idPhotoDeleteRequests IdPhotoDeleteRequest[]
  idPhotoAccessLogs  IdPhotoAccessLog[]
}

/// 會員證件版本（正／反面；現行＋歷史；實際檔在本機或 R2）
model MemberIdPhoto {
  id             String    @id // MIDP…
  memberId       Int
  member         Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// front | back
  side           String
  storageKey     String
  contentHash    String?
  byteSize       Int
  mimeType       String    @default("image/jpeg")
  isCurrent      Boolean   @default(true)
  supersededAt   DateTime?
  /// 歷史版：supersededAt + 1 年後可硬刪
  versionPurgeAt DateTime?
  /// 會籍結束基準 + 3 年（現行檔保存上限）
  retentionUntil DateTime
  legalHold      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  /// 臨櫃代辦：上傳員工（Staff JWT）
  uploadedByStaffId Int?
  uploadBranchId    Int?
  /// MEMBER_SELF | STAFF_USB_SCANNER | ONBOARDING
  uploadSource      String?
  consentSignatureId String?
  /// 後端補壓浮水印雜湊（稽核）
  watermarkHash     String?

  @@index([memberId, side, isCurrent])
  @@index([versionPurgeAt])
  @@index([retentionUntil])
  @@index([deletedAt])
}

/// 會員申請清除證件（須櫃檯核准後才刪）
model IdPhotoDeleteRequest {
  id              String    @id // IPDR…
  memberId        Int
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// front | back | both
  side            String
  reason          String?
  /// PENDING | APPROVED | REJECTED | CANCELLED
  status          String    @default("PENDING")
  requestedAt     DateTime  @default(now())
  resolvedAt      DateTime?
  resolverStaffId Int?
  resolveNote     String?

  @@index([memberId, status])
  @@index([status, requestedAt])
}

/// 證件存取／異動稽核（append-only）
model IdPhotoAccessLog {
  id            String   @id // IPAL…
  memberId      Int
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  photoId       String?
  side          String?
  /// UPLOAD | VIEW_MEMBER | VIEW_STAFF | DELETE_REQUEST | DELETE_APPROVE | DELETE_REJECT | DELETE_CANCEL | PURGE | SUPERSEDE
  action        String
  /// MEMBER | STAFF | SYSTEM
  actorType     String
  actorStaffId  Int?
  actorMemberId Int?
  detail        Json?
  ipAddress     String?
  userAgent     String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([memberId, createdAt])
  @@index([action, createdAt])
  @@index([actorStaffId, createdAt])
}

/// 會員 ↔ 分店綁定（進出場閘機驗證）
model MemberBranch {
  memberId Int
  branchId Int
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([memberId, branchId])
  @@index([branchId])
}

/** 手機 OTP（會員自助註冊／登入驗證；正式環境請接簡訊閘道） */
model PhoneOtp {
  id         Int       @id @default(autoincrement())
  phone      String
  codeHash   String
  purpose    String    // LOGIN | REGISTER
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  memberId   Int?
  member     Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([phone, purpose, createdAt])
}

/** Email OTP（登入／註冊／換機；code 僅存 hash，禁明碼入庫／日誌） */
model EmailOtp {
  id         Int       @id @default(autoincrement())
  email      String
  codeHash   String
  purpose    String    // LOGIN | REGISTER | DEVICE_RESET
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  memberId   Int?
  member     Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([email, purpose, createdAt])
  @@index([memberId, purpose, createdAt])
}

/// 裝置綁定／換機稽核（append-only）
model MemberDeviceAuditLog {
  id          Int      @id @default(autoincrement())
  memberId    Int
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  operatorId  Int?
  /// OPS_BIND | OPS_UNBIND | ADMIN_RESET | SELF_SWITCH
  action      String
  oldDeviceId String?
  newDeviceId String?
  oldDav      Int      @default(0)
  newDav      Int      @default(0)
  reason      String?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([memberId, createdAt])
  @@index([action, createdAt])
}

// 2. 全新新增的進出場紀錄表
model CheckInLog {
  id       Int @id @default(autoincrement())

  // 外鍵 (Foreign Key)：用來記錄這是哪位會員的紀錄
  memberId Int

  // 設定關聯對應：當 Member 被刪除時，其紀錄也會一併連帶刪除 (onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// 進場分店（閘機／裝置設定）；舊資料可為 null
  branchId Int?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  /// 進出場裝置（GateDevice）；舊資料可為 null
  gateDeviceId Int?
  gateDevice   GateDevice? @relation(fields: [gateDeviceId], references: [id], onDelete: SetNull)

  // 進場當下的計費快照。用來決定出場時要不要扣款
  billingMode String @default("計時扣款")

  // 進場時間：必填，預設為當下
  checkInAt DateTime @default(now())

  // 出場時間：可為空 (Nullable)，因為剛進場時還不知道什麼時候出場
  checkOutAt DateTime?

  // 本次消費金額：出場時才會計算並寫入
  fee Float @default(0.0)

  /// 最近一次出場刷卡時錢包不足之差額（未扣款、仍在場、閘機不開門；補儲值後重刷一次全額扣款並歸 0）
  shortfallAmt  Float @default(0.0)
  /// 出場實扣拆分（取消進出場時依此原路退回）
  deductedCash  Float @default(0.0)
  deductedBonus Float @default(0.0)

  // ACTIVE | CANCELLED（櫃檯取消進出場／沖銷費用）
  status String @default("ACTIVE")

  cancelledAt   DateTime?
  cancelReason  String?
  cancelledByStaffId Int?

  @@index([branchId, checkInAt])
  @@index([gateDeviceId, checkInAt])
  @@index([checkInAt])
  @@index([memberId, status, checkOutAt])
  /// 容留／在場列表：status=ACTIVE AND checkOutAt IS NULL
  @@index([status, checkOutAt])
  /// Partial unique（Prisma 無法表達）：uniq_active_member_checkin
  /// ON ("memberId") WHERE status='ACTIVE' AND checkOutAt IS NULL → npm run db:constraints
}

/// 進出場閘機／掃碼裝置（綁定分店；憑 deviceKey 驗證，不可由前端任意選店）
model GateDevice {
  id           Int       @id @default(autoincrement())
  /// 裝置代碼（如 HP-IN-01），全倉唯一
  code         String    @unique
  name         String
  branchId     Int
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  /// SHA-256(hex) of deviceKey；明文僅建立／輪替時回傳一次
  keyHash      String
  /// 裝置金鑰前綴（顯示用，非完整金鑰）
  keyPrefix    String?
  isActive     Boolean   @default(true)
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  checkInLogs  CheckInLog[]

  @@index([branchId, isActive])
}

// ==========================================
// 3. 促銷方案表 (升級：綁定特定分店)
// ==========================================
model Promotion {
  id          Int       @id @default(autoincrement())
  branchId    Int       // 【4.0 新增】這個方案屬於哪間店
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name        String    // 商品名稱，例如："迎新儲值500送100"
  /// SALE＝可售方案｜COMPENSATION＝客訴補償專案（price 必須 0；禁出現在櫃檯／會員購案列表）
  kind        String    @default("SALE")
  usageType   String    @default("TIMED") // TIMED(分鐘計費) | UNLIMITED(無限使用)
  planMode    String    @default("STANDING") // STANDING(長註) | CAMPAIGN(活動檔期)
  saleStartAt DateTime? // 活動上架時間（長註為 null）
  saleEndAt   DateTime? // 活動下架時間（長註為 null）
  /// 無限使用：每期天數（可自訂）；TIMED 為 null
  unitDays     Int?
  /// 無限使用：期數（可自訂）；TIMED 為 null
  periodCount  Int?
  /// 無限使用：有效天數＝unitDays × periodCount（購案延長用）
  durationDays Int?
  requiresMemberContract Boolean @default(false) // 需簽署會員合約
  enableCardRecurring    Boolean @default(false) // 啟用信用卡定期定額（無限使用：首期＝price、後續＝recurringAmount、總期數＝periodCount）
  /// 定期定額後續扣款金額（可與首期 price 不同；啟用時必填）
  recurringAmount        Float?
  /// PayUNi 續期 Hash · 臨櫃（商店後台「串接資訊」；空則用 PAYUNI_PERIOD_HASH／HASHES）
  payuniPeriodHash       String?
  /// PayUNi 續期 Hash · 會員線上（空則用 PAYUNI_PERIOD_HASH_ONLINE／HASHES …:online）
  payuniPeriodHashOnline String?
  price       Float     // 實際要收取的現金 (500)；COMPENSATION 強制 0
  bonusGiven  Float     // TIMED：贈送運動金；UNLIMITED 固定 0（不入錢包）；COMPENSATION 必須 > 0
  isActive    Boolean   @default(true) // 上下架狀態 (老闆隨時可停賣)
  createdAt   DateTime  @default(now())

  contractLinks PromotionMembershipContract[]
  cardSubscriptions CardSubscription[]
  hqCompensationLogs HqCompensationLog[]

  @@index([kind, isActive])
}

// ==========================================
// 課程方案（私教／團課商品化；與排程 Class 分離）
// ==========================================
model CoursePlan {
  id          Int       @id @default(autoincrement())
  branchId    Int
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name        String
  /// SALE＝可售方案｜COMPENSATION＝客訴補償課程（price 必須 0；禁出現在櫃檯／POS 購案）
  kind        String    @default("SALE")
  planType    String    // CUSTOM_PT(客製化私教) | GROUP(團體課程)
  /// 團體課子類：SERIES(期班) | POINTS(點數) | UNLIMITED_PASS(吃到飽) | PACKAGE(包班)；私教可空
  groupClassKind String?
  planMode    String    @default("STANDING") // STANDING(長註) | CAMPAIGN(活動檔期)
  saleStartAt DateTime?
  saleEndAt   DateTime?
  price       Float     // 方案售價；COMPENSATION 強制 0
  sessions    Int?      // 堂數（私教／套票）；COMPENSATION 必須 > 0
  capacity    Int?      // 團體課建議人數上限（參考）
  /// 團課單堂價（空＝不開放單堂）；期班價＝price、每期堂數＝sessions
  dropInPrice Float?
  /// 團課最低開班人數（0／空＝不設）
  minEnrollment Int?
  description String?
  requiresMemberContract Boolean @default(false) // 需簽署會員合約
  enableCardRecurring Boolean @default(false) // 啟用信用卡定期定額
  /// 可選期數 bitmask：2＝可選2期、4＝可選4期、6＝可選2或4期；null＝無
  recurringPeriods    Int?
  /// 2 期方案：第2期扣款金額（第1期＝price−本欄；需第1+第2＝price）
  recurringAmount     Float?
  /// 4 期方案：第1~3期共用扣款金額（需 ×3 + recurringAmountFinal ＝ price）
  recurringAmount4    Float?
  /// 4 期方案：第4期扣款金額
  recurringAmountFinal Float?
  /// PayUNi 續期 Hash · 臨櫃（商店後台「串接資訊」；空則用 PAYUNI_PERIOD_HASH／HASHES）
  payuniPeriodHash     String?
  /// PayUNi 續期 Hash · 會員線上（空則用 PAYUNI_PERIOD_HASH_ONLINE／HASHES …:online）
  payuniPeriodHashOnline String?
  /// 是否提供「課程第二人+$500(課程當日現場支付)」選項（結帳不入應付金額）
  enableSecondPerson Boolean @default(false)
  /// 加贈禮名稱；入購物車／訂單快照，金額 $0
  giftLabel   String?
  /// 加贈禮數量（預設 1）
  giftQty     Int?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contractLinks CoursePlanMembershipContract[]
  cardSubscriptions CardSubscription[]
  ptContracts       PTContract[]
  hqCompensationLogs HqCompensationLog[]
  classSeries       ClassSeries[]

  @@index([kind, isActive])
}

// ==========================================
// 會員合約範本（總部管理；與私教 PTContract 分離）
// ==========================================
model MembershipContract {
  id          Int      @id @default(autoincrement())
  title       String
  shortName   String?  // 頁面顯示用簡稱（過長標題時優先顯示）
  purpose     String   @default("GENERAL") // GENERAL | NEW_MEMBER（新會員入會，自助註冊必簽） | BIOMETRICS_CONSENT（生物辨識，各至多一份啟用）
  versionBase String   @default("V1") // 初版版本備註（建立時可編輯，之後鎖定）；修訂為 V1.1、V1.2…
  status      String   @default("ACTIVE") // ACTIVE | VOIDED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions   MembershipContractVersion[]
  changeLogs MembershipContractChangeLog[]
  promotions PromotionMembershipContract[]
  coursePlans CoursePlanMembershipContract[]
  signatures MemberContractSignature[]
}

model MembershipContractVersion {
  id               Int      @id @default(autoincrement())
  contractId       Int
  contract         MembershipContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  version          Int
  body             String   @db.Text
  /// 條文內容 SHA-256（簽署時比對，防事後竄改）
  bodyHash         String?
  changeNote       String?  // 建立此版本時的異動原因
  status           String   @default("ACTIVE") // ACTIVE | VOIDED（大規模異動升版後前版作廢）
  createdByStaffId Int?
  createdAt        DateTime @default(now())

  signatures MemberContractSignature[]
  changeLogs MembershipContractChangeLog[]

  @@unique([contractId, version])
  @@index([contractId, status])
}

/** 合約操作歷程：每次異動必填原因；小幅修正不升版也會記錄 */
model MembershipContractChangeLog {
  id               Int      @id @default(autoincrement())
  contractId       Int
  contract         MembershipContract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  versionId        Int?
  version          MembershipContractVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  action           String   // CREATE | UPDATE | BUMP_VERSION | VOID_CONTRACT | REACTIVATE
  changeNote       String   @db.Text
  summary          String?  // 變更摘要（標題／內容／升版等）
  createdByStaffId Int?
  createdAt        DateTime @default(now())

  @@index([contractId, createdAt])
}

/**
 * 電子合約全域稽核軌跡（append-only）
 * 涵蓋範本異動、開啟、簽署、重簽、指派等；簽名快照可存於 detail
 */
model ContractAuditLog {
  id           String   @id // CAL...
  contractId   Int?
  memberId     Int?
  signatureId  Int?
  versionId    Int?
  /// CREATE | UPDATE | BUMP_VERSION | VOID | REACTIVATE | OPEN | ASSIGN | SIGN | RESIGN | VIEW
  action       String
  summary      String?
  changeNote   String?  @db.Text
  detail       Json?
  actorStaffId Int?
  /// STAFF | ADMIN | MEMBER | SYSTEM
  actorType    String   @default("STAFF")
  ipAddress    String?
  userAgent    String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([contractId, createdAt])
  @@index([memberId, createdAt])
  @@index([action, createdAt])
}

model PromotionMembershipContract {
  promotionId Int
  contractId  Int
  promotion   Promotion          @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  contract    MembershipContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@id([promotionId, contractId])
}

model CoursePlanMembershipContract {
  coursePlanId Int
  contractId   Int
  coursePlan   CoursePlan          @relation(fields: [coursePlanId], references: [id], onDelete: Cascade)
  contract     MembershipContract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@id([coursePlanId, contractId])
}

model MemberContractSignature {
  id                Int       @id @default(autoincrement())
  memberId          Int
  contractId        Int
  contractVersionId Int
  status            String    @default("PENDING") // PENDING | SIGNED
  signatureData     String?   @db.Text // data:image/png;base64,...
  /// 簽署當下條文 hash（應與版本 bodyHash 一致）
  bodyHash          String?
  ipAddress         String?
  userAgent         String?   @db.Text
  /// STAFF | MEMBER
  actorType         String?
  signedAt          DateTime?
  staffId           Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  member          Member                     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  contract        MembershipContract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractVersion MembershipContractVersion  @relation(fields: [contractVersionId], references: [id], onDelete: Cascade)

  @@unique([memberId, contractVersionId])
  @@index([memberId, status])
}

/// 員工電子同意書簽署（與會員合約分離；append-only，撤回只標記 revokedAt）
model StaffConsentSignature {
  id               Int       @id @default(autoincrement())
  staffId          Int
  staff            Staff     @relation(fields: [staffId], references: [id], onDelete: Restrict)
  /// BIOMETRICS
  kind             String
  version          String
  /// 簽署當下條文 SHA-256
  bodyHash         String
  signerName       String
  signatureData    String    @db.Text // data:image/png;base64,...
  /// 見證／經辦員工（由 JWT 取得）
  witnessStaffId   Int?
  ipAddress        String?
  userAgent        String?   @db.Text
  signedAt         DateTime  @default(now())
  revokedAt        DateTime?
  revokedByStaffId Int?

  @@index([staffId, kind, signedAt])
}

// ==========================================
// 4. 教練與權限系統
// ==========================================
model Trainer {
  id          Int       @id @default(autoincrement())
  /// 真實姓名（總部／內部作業）
  name        String
  /// 對外顯示名稱（會員／LINE／公開介面）；預設匿名
  displayName String    @default("匿名")
  /// 教練對外簡介（會員端教練介紹）
  bio         String?   @db.Text
  /// 教練照片 URL
  photoUrl    String?
  phone       String    @unique
  role        String    @default("NORMAL") // NORMAL(一般教練), MANAGER(主管教練)
  /// 教練等級：GOLD(金牌), SILVER(銀牌)
  level       String    @default("SILVER")
  isActive    Boolean   @default(true)
  /// 綁定員工帳號：教練端僅能操作本人資料；總部 ADMIN 可跨教練
  staffId     Int?      @unique
  staff       Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)

  classes     Class[]
  classSeries ClassSeries[]
  ptContracts PTContract[] // 綁定該教練的私教合約
  branches    TrainerBranch[] // 該教練可授課的分店
  timeOffs    TrainerTimeOff[]
  consultGuests ConsultGuest[]
  trainingRecords TrainingRecord[]
  selfTrainingPlans SelfTrainingPlan[]
  commissionRules CoachCommissionRule[]
  commissionLedger CoachCommissionLedger[]
  googleCalendarLink GoogleCalendarLink?
  venueBookings VenueBooking[]
}

// 教練排休／不可預約時段（會員與排課需避開）
model TrainerTimeOff {
  id               Int      @id @default(autoincrement())
  trainerId        Int
  trainer          Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  startAt          DateTime
  endAt            DateTime
  /// 休假｜外出｜私人｜其他
  reason           String   @default("休假")
  note             String?
  createdByStaffId Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([trainerId, startAt])
  @@index([trainerId, endAt])
}

// 教練與分店的多對多權限中介表
model TrainerBranch {
  trainerId   Int
  branchId    Int
  trainer     Trainer   @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  @@id([trainerId, branchId]) // 複合主鍵
}

// ==========================================
// 5. 【全新】私教堂數合約 (PT Flow 核心)
// ==========================================
model PTContract {
  id            Int       @id @default(autoincrement())
  memberId      Int
  trainerId     Int
  member        Member    @relation(fields: [memberId], references: [id])
  trainer       Trainer   @relation(fields: [trainerId], references: [id])
  /// 購買分店（課程方案所屬）；私教上課僅限此店或 HP↔HR 共享場地
  branchId      Int?
  branch        Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// 來源方案（補償／購案追溯）；可空＝舊資料
  coursePlanId  Int?
  coursePlan    CoursePlan? @relation(fields: [coursePlanId], references: [id], onDelete: SetNull)
  /// PURCHASE＝付費購案｜COMPENSATION＝總部合規補償贈送（與購買區隔）
  source        String    @default("PURCHASE")

  totalSessions Int       // 購買／補償總堂數 (如: 24堂)
  usedSessions  Int       @default(0) // 已扣堂數
  pricePaid     Float     // 實際支付總金額；補償贈送為 0

  expiresAt     DateTime? // 合約到期日
  isActive      Boolean   @default(true)
  /// 購案訂單（退費依此精準定位合約；補償贈送為 null）
  orderId       String?   @unique
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// 退費停用時間（RefundRequest 結案）
  refundedAt    DateTime?
  createdAt     DateTime  @default(now())

  classes       Class[]

  @@index([branchId])
  @@index([coursePlanId])
  @@index([source, isActive])
}

// ==========================================
// 6. 課程與排班 (升級：綁定場地與課程類型)
// ==========================================

/// 團課期班（GROUP）：開始～結束日期 × 每週幾 × 上課時段 → 展開多堂 Class
model ClassSeries {
  id        Int      @id @default(autoincrement())
  title     String
  type      String   @default("GROUP") // 目前僅 GROUP
  venueId   Int
  venue     Venue    @relation(fields: [venueId], references: [id])
  stationId Int?
  station   VenueStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  trainerId Int
  trainer   Trainer  @relation(fields: [trainerId], references: [id])
  capacity  Int      @default(12)
  /// 期班開始日（台北日曆日）
  startDate DateTime @db.Date
  /// 期班結束日（含當日）
  endDate   DateTime @db.Date
  /// 每週幾：0=日 … 6=六（可多選）
  weekdays  Int[]
  /// HH:mm
  startTime String
  /// HH:mm
  endTime   String
  isActive  Boolean  @default(true)
  /// 付費期班：綁 GROUP 課程方案；舊資料可空（不可售）
  coursePlanId Int?
  coursePlan   CoursePlan? @relation(fields: [coursePlanId], references: [id], onDelete: SetNull)
  /// 開班時快照：整期價／單堂價（空＝不開放）／總堂數／最低開班人數
  termPrice     Float?
  dropInPrice   Float?
  sessionCount  Int?
  minEnrollment Int      @default(0)
  /// 開班人數判定截止（未達最低人數由總部取消並全額退費）
  enrollDeadline DateTime?
  /// OPEN | CANCELLED
  status        String   @default("OPEN")
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledByStaffId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes     Class[]
  enrollments GroupEnrollment[]
  waitlist    GroupWaitlist[]

  @@index([trainerId, startDate])
  @@index([venueId, startDate])
  @@index([coursePlanId, status])
}

/// 團課報名（整期 TERM／單堂 DROP_IN）；一筆報名＝一張 GRP 訂單＝一張發票
model GroupEnrollment {
  id        Int      @id @default(autoincrement())
  memberId  Int
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  seriesId  Int
  series    ClassSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  /// TERM | DROP_IN
  kind      String
  /// DROP_IN 之單堂
  classId   Int?
  /// PENDING(待付款保留名額) | ACTIVE | EXPIRED(逾時未付) | CANCELLED(未付款取消) | REFUNDED
  status    String   @default("PENDING")
  sessionsTotal Int
  unitPrice Float
  price     Float
  orderId   String?  @unique
  checkoutSessionId String?
  /// POS | ONLINE
  source    String
  holdExpiresAt DateTime?
  paidAt    DateTime?
  createdByStaffId Int?
  waitlistId Int?
  /// COOLING_OFF | STANDARD | SERIES_CANCELLED | DROP_IN
  refundKind   String?
  refundAmount Float?
  refundFee    Float?
  consumedSessions Int?
  refundReason String?
  refundedAt   DateTime?
  refundedByStaffId Int?
  /// 退款管道明細 { WALLET_CASH, LINEPAY, MANUAL }
  refundBreakdown Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations  Reservation[]
  makeupCredits GroupMakeupCredit[]

  @@index([memberId, status])
  @@index([seriesId, status])
  @@index([status, holdExpiresAt])
  @@index([checkoutSessionId])
}

/// 期班額滿候補：依序遞補、限時付款
model GroupWaitlist {
  id        Int      @id @default(autoincrement())
  seriesId  Int
  series    ClassSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  memberId  Int
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// WAITING | OFFERED | ENROLLED | EXPIRED | CANCELLED
  status    String   @default("WAITING")
  offeredAt DateTime?
  offerExpiresAt DateTime?
  /// MEMBER | STAFF
  source    String   @default("MEMBER")
  createdByStaffId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seriesId, status, createdAt])
  @@index([memberId, status])
}

/// 依規定請假（開課 ≥24h）取得之補課權：同課程方案其他期班有空位之單堂
model GroupMakeupCredit {
  id            Int      @id @default(autoincrement())
  memberId      Int
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  enrollmentId  Int
  enrollment    GroupEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  coursePlanId  Int?
  sourceReservationId Int @unique
  /// AVAILABLE | USED | EXPIRED | REVOKED
  status        String   @default("AVAILABLE")
  expiresAt     DateTime
  usedReservationId Int? @unique
  usedAt        DateTime?
  createdAt     DateTime @default(now())

  @@index([memberId, status])
  @@index([enrollmentId])
}

model Class {
  id      Int    @id @default(autoincrement())
  title   String // "館長諮詢", "1v1 深蹲特訓"
  type    String // "CONSULT"(諮詢), "PRIVATE"(私教), "GROUP"(團課)

  venueId Int // 【4.0 新增】在哪個場地上課
  venue   Venue @relation(fields: [venueId], references: [id])

  stationId Int? // 場地內站點（可空＝未指定細項）
  station   VenueStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  trainerId Int
  trainer   Trainer @relation(fields: [trainerId], references: [id])

  /// 所屬期班（團課期班展開之單堂）；私教／諮詢為 null
  seriesId Int?
  series   ClassSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  /// 私教扣堂之合約（教練業績依此合約單堂價計算）；舊資料可空
  ptContractId Int?
  ptContract   PTContract? @relation(fields: [ptContractId], references: [id], onDelete: SetNull)

  startAt DateTime
  endAt   DateTime

  capacity Int @default(1)

  reservations Reservation[]
  attendances  ClassAttendance[]
  checkInTokens ClassCheckInToken[]
  makeupSlots  MakeupSlot[]

  @@index([seriesId])
  @@index([trainerId, startAt])
  @@index([venueId, startAt])
}

model Reservation {
  id             Int           @id @default(autoincrement())
  /// 正式會員預約；諮詢客人可為空
  memberId       Int?
  member         Member?       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// 諮詢客人（姓名＋電話，尚未開通會員亦可）
  consultGuestId Int?
  consultGuest   ConsultGuest? @relation(fields: [consultGuestId], references: [id], onDelete: SetNull)
  classId        Int
  class          Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  status         String        @default("PENDING")
  /// MEMBER | LINE | TRAINER | CONSULT_GUEST
  source         String        @default("TRAINER")
  bookedAt       DateTime      @default(now())
  /// 團課報名（整期／單堂）；補課預約為 null、以 makeupCreditId 追溯
  enrollmentId   Int?
  enrollment     GroupEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  makeupCreditId Int?

  classLeave     ClassLeave?
  attendance     ClassAttendance?

  @@index([enrollmentId])
  @@index([classId, status])
  @@index([memberId, status])
  @@index([consultGuestId])
}

/// 諮詢客人（教練代登姓名／電話；可之後綁定正式會員）
model ConsultGuest {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  note      String?
  trainerId Int
  trainer   Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  /// 若電話已是會員或之後開通，可連結
  memberId  Int?
  member    Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reservations Reservation[]
  allocations  ConsultAllocation[]

  @@unique([trainerId, phone])
  @@index([phone])
  @@index([trainerId, isActive])
}

model Order {
  id            String   @id // 必須是 String，因為你的訂單編號是 TYK 開頭
  memberId      Int
  amount        Float    // 台幣通常用整數，但對應你程式碼裡的 parseFloat
  itemDesc      String
  payMethod     String?  // 複合：CASH+CARD+VOUCHER
  payBreakdown  Json?
  voucherCode   String?
  cardAmount    Float    @default(0)
  /// 刷卡模式：LUMP（一次付清）｜INSTALLMENT（分期）｜RECURRING（定期定額）
  cardMode      String?  @default("LUMP")
  /// 分期期數（3/6/9/12/18/24/30）；僅 INSTALLMENT
  cardInst      Int?
  /// 定期定額週期：W｜M｜Y
  periodType    String?
  /// 定期定額總期數；0 或不設＝不限
  periodTimes   Int?
  /// 續扣基準金額（定期定額）；未設則用 cardAmount／amount
  recurringAmount Float?
  /// 最末期扣款金額（課程 4 期）；未設則續扣皆用 recurringAmount
  recurringAmountFinal Float?
  /// PayUNi CreditHash（約定扣款 Token）
  creditHash    String?
  status        String   @default("PENDING") // 狀態：PENDING, PAID, FAILED
  merchantNo    String?  // 統一金流端產生的交易序號
  /// 提供服務分店（發票開立營業人＝此分店之 LegalEntity）；發票本體見 EInvoice(refId=id)
  branchId      Int?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  /// 合併結帳工作階段（CHK…）
  checkoutSessionId String?
  /// 計時儲值入帳快照（本金／運動金）；原單取消只能依此回收，禁止改由 itemDesc 或 Promotion 反推
  grantedCash   Int?
  grantedBonus  Int?
  /// 已退款累計（含稅，經 RefundRequest 結案寫入）
  refundedAmount Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 關聯設定：一筆訂單屬於一個會員
  member        Member   @relation(fields: [memberId], references: [id])
  ptContract    PTContract?

  @@index([checkoutSessionId])
  @@index([branchId])
  @@index([status, createdAt])
  @@index([memberId, createdAt])
}

// ==========================================
// 信用卡定期定額訂閱（首期 UPP 綁 Token，後續幕後 CreditHash 扣款）
// ==========================================
model CardSubscription {
  id             String   @id // CRS...
  memberId       Int
  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// 儲值方案訂閱（與 coursePlanId 擇一）
  promotionId    Int?
  promotion      Promotion? @relation(fields: [promotionId], references: [id])
  /// 課程方案分期（與 promotionId 擇一）
  coursePlanId   Int?
  coursePlan     CoursePlan? @relation(fields: [coursePlanId], references: [id])
  /// 首期訂單編號（TYK…／CRS…）
  originOrderId  String?
  creditHash     String
  /// 續扣基準金額（課程 2 期＝第2期；4 期＝第2~3期；儲值＝每期）
  amount         Float
  /// 最末期扣款金額（課程 4 期第4期；其餘可空＝沿用 amount）
  amountFinal    Float?
  periodType     String // W | M | Y
  /// 總扣款期數；0＝不限（含首期）
  periodTimes    Int      @default(0)
  /// 已成功扣款次數（含首期）
  chargedCount   Int      @default(1)
  /// ACTIVE | PAUSED | CANCELLED | COMPLETED | FAILED
  status         String   @default("ACTIVE")
  nextChargeAt   DateTime
  lastChargeAt   DateTime?
  failCount      Int      @default(0)
  lastError      String?
  /// 每月扣款日（1–28）；null＝依 periodType 天數遞延
  chargeDayOfMonth Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  charges        CardSubscriptionCharge[]
  leaves         MemberLeave[]

  @@index([status, nextChargeAt])
  @@index([memberId])
  @@index([coursePlanId])
  @@unique([originOrderId])
}

/// 無限使用（訂閱制月卡）請假：效期預先順延、定期定額暫停並順延 nextChargeAt
model MemberLeave {
  id                 Int       @id @default(autoincrement())
  memberId           Int
  member             Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  subscriptionId     String?
  subscription       CardSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  /// 申請請假天數
  days               Int
  startAt            DateTime
  endAt              DateTime
  /// 請假開始前的效期快照
  expireDateBefore   DateTime?
  /// 請假開始前的下次扣款時間快照
  nextChargeAtBefore DateTime?
  /// ACTIVE=請假中 | ENDED=已結束（含提早銷假）| CANCELLED=作廢
  status             String    @default("ACTIVE")
  reason             String?
  /// 請假證明物件 storageKey（local／R2，非公開 URL）
  proofStorageKey    String?
  proofFileName      String?
  staffId            Int?
  createdAt          DateTime  @default(now())
  endedAt            DateTime?

  @@index([memberId, status])
  @@index([status, endAt])
}

model CardSubscriptionCharge {
  id             String   @id // CRC...
  subscriptionId String
  subscription   CardSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// 本期對應 Order（續扣建立）
  orderId        String?
  merchantNo     String?
  amount         Float
  /// 期別序號（2 起；1 為首期 UPP，不寫入此表或寫 SUCCESS 紀錄）
  periodIndex    Int
  /// PENDING | PAID | FAILED
  status         String   @default("PENDING")
  errorMessage   String?
  attemptedAt    DateTime @default(now())
  paidAt         DateTime?

  @@unique([subscriptionId, periodIndex])
}

// ==========================================
// 7. 進銷存：商品主檔 / 分店庫存 / 庫存流水 / 供應商 / 採購 / 驗收 / 應付（與 Promotion 儲值分離）
// 金額一律整數元（Int）；成本單價 Decimal(12,4)（移動平均）
// ==========================================
/// 商品主檔（全公司共用；售價／庫存在 BranchStock）
model Product {
  id          Int      @id @default(autoincrement())
  sku         String   @unique
  /// 國際條碼（掃碼槍）
  barcode     String?  @unique
  name        String
  /// 發票品名（≤30 字；未設用 name）
  invoiceName String?
  unit        String   @default("個")
  /// PHYSICAL=實體控庫存 | SERVICE=服務類不控庫存（禁進貨／盤點／安全庫存預警）
  productKind String   @default("PHYSICAL")
  /// TAXABLE 應稅 | TAX_FREE 免稅
  taxType     String   @default("TAXABLE")
  /// 建議售價（含稅；分店未設 salePrice 時採用）
  listPrice   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stocks             BranchStock[]
  movements          StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  receiptItems       PurchaseReceiptItem[]
  saleItems          SaleItem[]
}

/// 分店庫存（上架、售價、現量、移動平均成本）；onHand 只能經 StockMovement 交易異動
model BranchStock {
  id          Int      @id @default(autoincrement())
  branchId    Int
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// 分店售價（含稅）；null＝採 Product.listPrice
  salePrice   Int?
  onHand      Int      @default(0)
  /// 移動平均成本（未稅）
  avgCost     Decimal  @default(0) @db.Decimal(12, 4)
  /// 安全庫存（僅 PHYSICAL）
  safetyStock Int?
  /// 是否於本店 POS 上架
  isListed    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([productId])
}

/// 庫存流水（帶號；balanceAfter＝異動後現量）
model StockMovement {
  id           Int      @id @default(autoincrement())
  branchId     Int
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  productId    Int
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// 帶號數量：入庫正、出庫負（盤點無差異可為 0）
  qtyDelta     Int
  balanceAfter Int
  /// 未稅單位成本快照
  unitCost     Decimal? @db.Decimal(12, 4)
  /// RECEIPT | SALE | SALE_CANCEL | LOSS | GAIN | STOCKTAKE | TRANSFER_OUT | TRANSFER_IN | OPENING
  refType      String
  refId        String?
  refLineId    Int?
  reason       String?
  staffId      Int?
  createdAt    DateTime @default(now())

  @@index([branchId, productId, createdAt])
  @@index([refType, refId])
}

/// 供應商（全公司共用；應付帳款依營業人分帳）
model Supplier {
  id              Int      @id @default(autoincrement())
  name            String
  /// 供應商統編（可空：個人／國外）
  ubn             String?  @unique
  contactName     String?
  phone           String?
  email           String?
  address         String?
  /// NET 驗收後 N 日 | EOM 月結 N 日（次月起算）| COD 貨到付款
  paymentTermType String   @default("NET")
  paymentTermDays Int      @default(30)
  note            String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  receipts       PurchaseReceipt[]
  payables       SupplierPayable[]
  payments       SupplierPayment[]
}

/// 採購單（POH…）：DRAFT → ORDERED → PARTIAL → RECEIVED → CLOSED；DRAFT／ORDERED 可 CANCELLED
model PurchaseOrder {
  id               String      @id
  legalEntityId    Int
  legalEntity      LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  branchId         Int
  branch           Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplierId       Int
  supplier         Supplier    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status           String      @default("DRAFT")
  expectedAt       DateTime?
  /// 未稅小計／稅額／含稅總額（後端依明細計算）
  subtotal         Int         @default(0)
  taxAmount        Int         @default(0)
  total            Int         @default(0)
  note             String?
  createdByStaffId Int?
  orderedAt        DateTime?
  closedAt         DateTime?
  cancelReason     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items    PurchaseOrderItem[]
  receipts PurchaseReceipt[]

  @@index([branchId, status])
  @@index([supplierId, status])
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  qtyOrdered      Int
  qtyReceived     Int           @default(0)
  /// 未稅進價
  unitCost        Decimal       @db.Decimal(12, 4)
  /// TAXABLE | TAX_FREE（進項稅）
  taxType         String        @default("TAXABLE")

  receiptItems PurchaseReceiptItem[]

  @@unique([purchaseOrderId, productId])
}

/// 驗收入庫單（PRC…）：一次到貨一張；入庫即產生應付
model PurchaseReceipt {
  id                  String          @id
  purchaseOrderId     String?
  purchaseOrder       PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  legalEntityId       Int
  legalEntity         LegalEntity     @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  branchId            Int
  branch              Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplierId          Int
  supplier            Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// 供應商開立之進項發票號（可後補）
  supplierInvoiceNo   String?
  supplierInvoiceDate DateTime?
  subtotal            Int             @default(0)
  taxAmount           Int             @default(0)
  total               Int             @default(0)
  receivedAt          DateTime        @default(now())
  staffId             Int?
  note                String?
  createdAt           DateTime        @default(now())

  items   PurchaseReceiptItem[]
  payable SupplierPayable?

  @@index([branchId, receivedAt])
  @@index([supplierId, receivedAt])
}

model PurchaseReceiptItem {
  id        Int                @id @default(autoincrement())
  receiptId String
  receipt   PurchaseReceipt    @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  poItemId  Int?
  poItem    PurchaseOrderItem? @relation(fields: [poItemId], references: [id], onDelete: Restrict)
  productId Int
  product   Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  qty       Int
  unitCost  Decimal            @db.Decimal(12, 4)
  taxType   String             @default("TAXABLE")
}

/// 應付帳款（APY…）：一張驗收單一筆；RETURN／ADJUST 可為負
model SupplierPayable {
  id                String          @id
  legalEntityId     Int
  legalEntity       LegalEntity     @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  supplierId        Int
  supplier          Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  receiptId         String?         @unique
  receipt           PurchaseReceipt? @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  /// PURCHASE | RETURN | ADJUST
  type              String          @default("PURCHASE")
  supplierInvoiceNo String?
  amount            Int
  paidAmount        Int             @default(0)
  dueDate           DateTime
  /// OPEN | PARTIAL | PAID | VOID
  status            String          @default("OPEN")
  note              String?
  voidReason        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  allocations SupplierPaymentAllocation[]

  @@unique([supplierId, supplierInvoiceNo])
  @@index([legalEntityId, status, dueDate])
}

/// 付款（APM…）：可沖銷多筆應付
model SupplierPayment {
  id            String      @id
  legalEntityId Int
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  supplierId    Int
  supplier      Supplier    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  amount        Int
  /// TRANSFER | CASH | CHECK
  method        String      @default("TRANSFER")
  paidAt        DateTime    @default(now())
  reference     String?
  note          String?
  staffId       Int?
  createdAt     DateTime    @default(now())

  allocations SupplierPaymentAllocation[]

  @@index([legalEntityId, paidAt])
}

model SupplierPaymentAllocation {
  id        Int             @id @default(autoincrement())
  paymentId String
  payment   SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  payableId String
  payable   SupplierPayable @relation(fields: [payableId], references: [id], onDelete: Restrict)
  amount    Int

  @@unique([paymentId, payableId])
}

model SaleOrder {
  id            String   @id // SAL...
  branchId      Int
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  /// 開立營業人（＝分店 LegalEntity 快照）
  legalEntityId Int
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  memberId      Int?
  member        Member?  @relation(fields: [memberId], references: [id])
  payMethod     String // 複合：CASH+CARD+VOUCHER 等
  payBreakdown  Json? // { CASH: 100, CARD: 200, WALLET_CASH: 0, VOUCHER: 50 }
  voucherCode   String? // 抵用券條碼
  status        String   @default("PENDING") // PENDING | PAID | CANCELLED
  amount        Int // 訂單總額（含稅）
  cardAmount    Int      @default(0) // 刷卡待收／已收部分（複合時）
  cardMode      String?  @default("LUMP") // LUMP | INSTALLMENT | RECURRING
  cardInst      Int?
  periodType    String?
  periodTimes   Int?
  creditHash    String?
  itemDesc      String
  merchantNo    String?
  staffId       Int?
  /// 合併結帳工作階段（CHK…）
  checkoutSessionId String?
  /// 已退款累計（含稅）；全部品項退完才改 CANCELLED
  refundedAmount Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         SaleItem[]

  @@index([branchId, status, createdAt])
  @@index([checkoutSessionId])
}

// ==========================================
// 臨櫃合併結帳：商品 + 購案同一筆付款；發票依子單分腿開立（EInvoice）
// ==========================================
model CheckoutSession {
  id              String   @id // CHK...
  branchId        Int?
  branch          Branch?  @relation(fields: [branchId], references: [id])
  memberId        Int?
  member          Member?  @relation(fields: [memberId], references: [id])
  amount          Float // 購物車查價合計（首期應付）
  itemDesc        String
  payMethod       String?
  payBreakdown    Json?
  voucherCode     String?
  cardAmount      Float    @default(0)
  cardMode        String?  @default("LUMP")
  cardInst        Int?
  periodType      String?
  periodTimes     Int?
  /// 定期定額續扣金額（可與首期刷卡額不同）
  recurringAmount Float?
  /// 最末期扣款金額（課程 4 期）
  recurringAmountFinal Float?
  /// 結帳當下選定的 PayUNi 續期 Hash（方案欄或 env map）
  payuniPeriodHash String?
  creditHash      String?
  status          String   @default("PENDING") // PENDING | PAID | FAILED | CANCELLED
  merchantNo      String?
  saleOrderId     String?  @unique
  orderId         String?  @unique
  /// 私教課程購物車快照：[{ coursePlanId, name, qty, unitPrice, lineTotal, sessions, totalSessions, branchId }]
  ptItems         Json?
  trainerId       Int?
  /// 刷卡成功後是否已建立 PTContract（idempotent）
  ptFulfilled     Boolean  @default(false)
  staffId         Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([memberId])
}

model SaleItem {
  id          Int       @id @default(autoincrement())
  saleOrderId String
  saleOrder   SaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product   @relation(fields: [productId], references: [id])
  name        String // 成交快照
  unitPrice   Int // 含稅
  qty         Int
  lineTotal   Int
  /// TAXABLE | TAX_FREE（成交快照）
  taxType     String    @default("TAXABLE")
  /// 銷貨成本快照（移動平均，未稅）
  unitCost    Decimal?  @db.Decimal(12, 4)
  /// 已退貨數量（DB CHECK 0 ≤ refundedQty ≤ qty）
  refundedQty Int       @default(0)
}

// ==========================================
// 8. ezPay 電子發票：開立營業人＝提供服務／出貨分店之 LegalEntity
// ==========================================
/// 開票請求（交易當下買受人選項；一單據一筆，子單由 CHK 繼承）
model InvoiceRequest {
  /// SAL… / TYK… / GRP… / CRS… / CHK…
  refId      String   @id
  /// ORDER | SALE | CHECKOUT
  refType    String
  buyerName  String?
  buyerUbn   String?
  carrierNum String?
  loveCode   String?
  buyerEmail String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// 電子發票（一筆＝一張）；開票失敗留 FAILED 由佇列重試，禁止沖回已收款
model EInvoice {
  id                String       @id // EIV…
  /// 開立營業人；分店未綁營業人時暫空，佇列處理時依 branchId 重新解析
  legalEntityId     Int?
  legalEntity       LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  /// 提供服務分店快照
  branchId          Int?
  /// ORDER | SALE | CHECKOUT（舊版合併單一發票）
  refType           String
  refId             String
  /// SALE | PROMO | PT | GROUP | ORDER | ALL
  leg               String      @default("ALL")
  /// 同 ref+leg 作廢後重開序號
  seq               Int         @default(1)
  checkoutSessionId String?
  memberId          Int?
  /// ezPay 自訂編號（≤20 英數_；同營業人唯一）
  merchantOrderNo   String
  /// B2C | B2B
  category          String
  buyerName         String?
  buyerUbn          String?
  buyerEmail        String?
  /// 0 手機條碼 | 1 自然人憑證
  carrierType       String?
  carrierNum        String?
  loveCode          String?
  printFlag         String      @default("N")
  /// 1 應稅 | 3 免稅 | 9 混合
  taxType           String      @default("1")
  taxRate           Int         @default(5)
  /// 銷售額（未稅）
  salesAmount       Int
  taxAmount         Int
  totalAmount       Int
  itemDesc          String
  /// PENDING | ISSUING | ISSUED | FAILED | VOIDED（已開立後作廢）| CANCELLED（未開立即取消）
  status            String      @default("PENDING")
  invoiceNumber     String?     @unique
  randomNum         String?
  ezpayTransNo      String?
  issuedAt          DateTime?
  /// 發票期別（雙月起月 YYYYMM）
  periodKey         String?
  allowanceTotal    Int         @default(0)
  voidedAt          DateTime?
  voidReason        String?
  voidedByStaffId   Int?
  retryCount        Int         @default(0)
  nextRetryAt       DateTime?
  lastError         String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items      EInvoiceItem[]
  allowances InvoiceAllowance[]
  logs       EInvoiceLog[]

  @@unique([legalEntityId, merchantOrderNo])
  @@index([refId, leg])
  @@index([checkoutSessionId])
  @@index([status, nextRetryAt])
  @@index([legalEntityId, issuedAt])
}

model EInvoiceItem {
  id         Int      @id @default(autoincrement())
  einvoiceId String
  einvoice   EInvoice @relation(fields: [einvoiceId], references: [id], onDelete: Cascade)
  lineNo     Int
  name       String
  qty        Int
  unit       String   @default("式")
  /// B2C 含稅、B2B 未稅（與送 ezPay 一致）
  unitPrice  Int
  amount     Int
  /// 1 應稅 | 3 免稅
  taxType    String   @default("1")
  productId  Int?
  /// 銷貨明細來源（退貨折讓逐行對應）
  saleItemId Int?
  /// 已折讓數量／含稅金額累計（逐行稽核；退貨數量上限以 SaleItem.refundedQty 為準）
  allowedQty    Int   @default(0)
  allowedAmount Int   @default(0)
  allowanceItems InvoiceAllowanceItem[]

  @@index([einvoiceId])
  @@index([saleItemId])
}

/// ezPay 呼叫紀錄（每次開立／查詢補登／作廢／折讓一筆，僅追加）；供總部查錯，禁止寫入 HashKey／HashIV 或加密內容
model EInvoiceLog {
  id            Int       @id @default(autoincrement())
  einvoiceId    String?
  einvoice      EInvoice? @relation(fields: [einvoiceId], references: [id], onDelete: SetNull)
  refId         String?
  legalEntityId Int?
  merchantId    String?
  /// ISSUE | RECOVER（查詢補登）| VOID | ALLOWANCE
  action        String
  /// SUCCESS | FAILED | NOT_FOUND
  result        String
  /// 該張發票第幾次開立嘗試
  attempt       Int?
  manual        Boolean   @default(false)
  staffId       Int?
  /// 系統錯誤代碼（EZPAY_NETWORK、EZPAY_REJECTED、EZPAY_CHECKCODE_MISMATCH…）
  errorCode     String?
  /// ezPay 回傳 Status（SUCCESS、INV10003、LIB10003…）
  ezpayStatus   String?
  message       String?
  invoiceNumber String?
  durationMs    Int?
  createdAt     DateTime  @default(now())

  @@index([einvoiceId, createdAt])
  @@index([result, createdAt])
  @@index([legalEntityId, createdAt])
}

/// ezPay 折讓單（開立成功後寫入；稽核／列印）
model InvoiceAllowance {
  id              String       @id // IAL…
  /// ezPay 折讓號
  allowanceNo     String       @unique
  einvoiceId      String?
  einvoice        EInvoice?    @relation(fields: [einvoiceId], references: [id], onDelete: Restrict)
  legalEntityId   Int?
  legalEntity     LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  invoiceNumber   String
  merchantOrderNo String
  orderId         String?
  saleOrderId     String?
  memberId        Int?
  memberName      String?
  itemDesc        String?
  untaxedAmt      Int
  taxAmt          Int
  totalAmt        Int
  remainAmt       Int?
  buyerEmail      String?
  /// TOPUP_VOID | SUB_ORDER_REFUND | REFUND | CANCEL_SALE | CANCEL_PT | SUB_CANCEL | GROUP_REFUND | MANUAL
  source          String       @default("REFUND")
  /// ISSUED | VOIDED
  status          String       @default("ISSUED")
  staffId         Int?
  /// 列印用營業人（開立當下快照）
  sellerName      String?
  sellerUbn       String?
  sellerAddress   String?
  /// 退費單（RFD…）與子單（SAL／TYK／CRS…）
  refundId        String?
  subOrderId      String?
  /// 原發票分店快照（查詢範圍）
  branchId        Int?
  /// 原發票開立日與期別（列印字軌／對帳）
  invoiceIssuedAt  DateTime?
  invoicePeriodKey String?
  /// B2B | B2C；買受人僅 B2B 存名稱／統編
  category        String?
  buyerUbn        String?
  buyerName       String?
  reason          String?
  /// 顧客親簽（RefundSignature.id）
  signatureId     String?
  /// 列印次數（僅 print-payload?purpose=print 遞增；>1 為補印）
  printCount           Int       @default(0)
  lastPrintedAt        DateTime?
  lastPrintedByStaffId Int?
  /// 首次會計匯出（POST /ops/allowances/export 寫入，之後不覆寫）
  exportedToAcctAt     DateTime?
  exportedByStaffId    Int?
  items           InvoiceAllowanceItem[]
  createdAt       DateTime     @default(now())

  @@index([invoiceNumber])
  @@index([einvoiceId])
  @@index([orderId])
  @@index([createdAt])
  @@index([refundId])
  @@index([branchId, createdAt])
  @@index([memberId, createdAt])
  @@index([exportedToAcctAt])
}

/// 折讓明細快照（送 ezPay 之品項；單價／金額一律未稅）
model InvoiceAllowanceItem {
  id             Int              @id @default(autoincrement())
  allowanceId    String
  allowance      InvoiceAllowance @relation(fields: [allowanceId], references: [id], onDelete: Cascade)
  einvoiceItemId Int?
  einvoiceItem   EInvoiceItem?    @relation(fields: [einvoiceItemId], references: [id], onDelete: SetNull)
  saleItemId     Int?
  lineNo         Int
  name           String
  qty            Int
  unit           String           @default("式")
  unitPrice      Int
  amount         Int
  taxAmt         Int
  /// 含稅（amount + taxAmt）
  grossAmount    Int
  /// 1 應稅 | 3 免稅
  taxType        String           @default("1")

  @@index([allowanceId])
}

// ==========================================
// 9. 交易取消／退費（RefundRequest）：分段狀態機；外部金流與 ezPay 一律在交易外呼叫
// ==========================================
/// 退費單：PAYMENT_PENDING → AWAITING_TERMINAL → INVOICE_PENDING → SIGNATURE_PENDING → COMPLETED（失敗分支可重試／中止）
model RefundRequest {
  id                  String   @id // RFD…
  /// TOPUP_VOID | SALE_RETURN | ORDER_REFUND
  kind                String
  /// SALE | ORDER
  refType             String
  /// 子單號（SAL… / TYK… / CRS…）
  refId               String
  checkoutSessionId   String?
  branchId            Int?
  memberId            Int?
  /// FULL | UNUSED | ITEMS
  scope               String
  /// 退貨品項快照 [{ orderItemId, name, qty, unitPrice, gross, taxType, productId }]
  lines               Json?
  /// 後端試算快照（公式、已使用、手續費）
  calc                Json?
  /// 應退含稅總額（含抵用券不退現部分）
  grossAmount         Int
  feeAmount           Int      @default(0)
  consumedValue       Int      @default(0)
  /// 實際退回顧客（不含 FORFEITED）
  payoutAmount        Int      @default(0)
  /// 子單是否全額退（發票判定用）
  fullRefund          Boolean  @default(false)
  /// VOID | ALLOWANCE | CANCEL_UNISSUED | NONE（INVOICE_PENDING 時才決定）
  invoiceAction       String?
  /// 處理結果 [{ einvoiceId, invoiceNumber, action, allowanceId?, allowanceNo? }]
  invoiceResults      Json?
  /// B2B 須顧客親簽才可結案
  signatureRequired   Boolean  @default(false)
  signatureId         String?
  walletCashReversed  Float    @default(0)
  walletBonusReversed Float    @default(0)
  walletCashCredited  Float    @default(0)
  /// 必填退折讓原因
  reason              String
  buyerEmail          String?
  staffId             Int
  /// 前端每次送出產生之冪等鍵（Header Idempotency-Key）；重送回傳同一張退費單
  idempotencyKey      String?  @unique
  /// PAYMENT_PENDING | AWAITING_TERMINAL | PAYMENT_FAILED | INVOICE_PENDING | INVOICE_FAILED | SIGNATURE_PENDING | GATEWAY_RETRYING | COMPLETED | ABORTED
  status              String
  lastError           String?
  completedAt         DateTime?
  abortedAt           DateTime?
  abortReason         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  payments   RefundPayment[]
  signatures RefundSignature[]

  @@index([refType, refId])
  @@index([branchId, createdAt])
  @@index([status, createdAt])
  @@index([memberId, createdAt])
}

/// 退費單之單一退款管道
model RefundPayment {
  id              String        @id // RFP…
  refundId        String
  refund          RefundRequest @relation(fields: [refundId], references: [id], onDelete: Cascade)
  /// CASH | WALLET_CASH | LINEPAY | PAYUNI | YIPAY | VOUCHER
  method          String
  amount          Int
  /// PENDING | PROCESSING | AWAITING_TERMINAL | REFUNDED | FAILED | FORFEITED
  /// REVERSED＝中止時沖回（現金須向顧客收回）｜CANCELLED＝改臨櫃現金或中止時未執行之腿
  status          String
  /// 原交易序號（LINE Pay transactionId／PayUNi TradeNo）
  originalRef     String?
  /// 退款所屬原付款訂單（課程分期跨期退款時為各期訂單；空＝退費單 refId）
  refOrderId      String?
  /// 退款序號（LINE Pay refundTransactionId／PayUNi 回傳）
  providerRef     String?
  /// 乙禾端末退貨憑證
  rrn             String?
  authCode        String?
  cardLast4       String?
  terminalRef     String?
  origCaptureId   String?
  /// 現金退款綁定之交班（ShiftHandover.id）
  shiftHandoverId String?
  attempts        Int           @default(0)
  lastError       String?
  staffId         Int?
  refundedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([refundId])
  @@index([method, status])
  @@index([shiftHandoverId])
}

/// 折讓顧客親簽（影像存私有儲存，禁止公開路徑／DB base64）
model RefundSignature {
  id         String        @id // RSG…
  refundId   String
  refund     RefundRequest @relation(fields: [refundId], references: [id], onDelete: Cascade)
  storageKey String
  sha256     String
  /// 客顯簽署請求（ALLOWANCE_SIGN_REQUEST.requestId）與顧客所見折讓內容摘要（previewToken 內 digest）
  requestId     String?
  previewDigest String?
  /// 經辦（Staff JWT）
  staffId    Int
  ipAddress  String?
  userAgent  String?
  signedAt   DateTime      @default(now())

  @@index([refundId])
}

/// 雙錢包異動流水（append-only；唯一寫入口 lib/walletMutation.js，一次異動一列、雙錢包前後水位；DB CHECK before＋delta＝after、after ≥ 0）
model WalletLedger {
  id           Int      @id @default(autoincrement())
  memberId     Int
  /// 異動類別（WALLET_TX）：TOPUP_GRANT | WALLET_PAY | POS_PENDING_ABORT_RESTORE | GATE_CHECKOUT | GATE_FEE_REFUND | TOPUP_VOID | REFUND_REVERSE | REFUND_CREDIT | REFUND_ABORT | GROUP_REFUND | HQ_COMPENSATION | GIFT_CARD_REDEEM
  reasonCode   String
  branchId     Int?
  cashBefore   Float?
  cashDelta    Float?
  cashAfter    Float?
  bonusBefore  Float?
  bonusDelta   Float?
  bonusAfter   Float?
  /// 異動說明（必填；稽核用）
  reason       String?
  /// 舊制單錢包列（CASH | BONUS）；新制列為 null
  wallet       String?
  delta        Float?
  balanceAfter Float?
  /// ORDER | SALE | CHECKOUT | CHECKIN | GROUP_ENROLLMENT | HQ_COMPENSATION | GIFT_CARD …
  refType      String?
  refId        String?
  refundId     String?
  staffId      Int?
  createdAt    DateTime @default(now())

  @@index([memberId, createdAt])
  @@index([refundId])
  @@index([refType, refId])
}

/// 交易異動稽核（append-only；前後狀態快照）
model TransactionAuditLog {
  id        Int      @id @default(autoincrement())
  /// TOPUP_CANCEL | SUB_ORDER_REFUND | REFUND_PAYMENT | REFUND_YIPAY_CONFIRM | REFUND_INVOICE | REFUND_INVOICE_RESOLVE | REFUND_GATEWAY_CONFIRM | REFUND_EXPIRED_COURSE_APPROVAL | REFUND_SHORTFALL_CONFIRM | REFUND_SHORTFALL_RECOVERY | REFUND_RETRY | REFUND_ABORT | REFUND_SIGNATURE_PREVIEW | REFUND_SIGNATURE | REFUND_COMPLETE | ALLOWANCE_PRINT | ALLOWANCE_EXPORT
  action    String
  refundId  String?
  refType   String?
  refId     String?
  staffId   Int?
  staffRole String?
  branchId  Int?
  reason    String?
  before    Json?
  after     Json?
  clientIp  String?
  createdAt DateTime @default(now())

  @@index([refundId, createdAt])
  @@index([refType, refId])
  @@index([branchId, createdAt])
  @@index([action, createdAt])
}

// 廠館員工與管理員表
model Staff {
  id        Int      @id @default(autoincrement())
  
  // 登入憑證 (嚴格禁止使用員工私人 LINE 綁定登入，一律配發內部帳號；LINE 僅可綁作推播收件，見 lineUserId)
  account   String   @unique
  password  String   // 這裡之後會存 bcrypt 加密後的雜湊值，絕對不存明碼
  
  // 基本資料
  /// 真實姓名（總部／交接班／內部作業）
  name      String
  /// 對外／側欄顯示名稱；預設匿名
  displayName String @default("匿名")
  
  /// 職位（定義見 lib/orgStructure.js）：ADMIN／GM／FM／STORE_MANAGER（舊 MANAGER）／DUTY／STAFF／TRAINER
  /// 交易異動僅 DUTY 以上
  role      String   @default("STAFF")

  /// 綁定分店（ADMIN／GM／FM 可為 null；其餘必填，且須符合分店類型）
  branchId  Int?
  branch    Branch?  @relation(fields: [branchId], references: [id])

  // 模組權限：ops | pt | trainer（ADMIN 忽略，視為全開）
  permissions String[] @default([])
  
  // 帳號狀態 (離職或調職時直接設為 false，保留操作歷史不刪除帳號)
  isActive  Boolean  @default(true)

  /// 勞動條件（lib/laborLaw.js）：FULL_TIME 正職 | PART_TIME 兼職（部分工時）| INTERN 實習
  employmentType  String    @default("FULL_TIME")
  /// 到職日（年資、特休起算）
  hireDate        DateTime? @db.Date
  /// 約定每週正常工時；兼職必填（<40）、實習選填，正職視為 40
  weeklyHours     Float?
  /// 實習無勞雇關係（學校課程實習／建教生）者 false，不適用勞基法假別
  laborActApplies Boolean   @default(true)

  /// 員工照片（私有儲存 key；原圖供人臉辨識、縮圖供頭像），禁止公開目錄
  photoKey       String?
  photoThumbKey  String?
  photoUpdatedAt DateTime?
  /// Face8 員工群組 faceId（PAPAGO_STAFF_GROUP_ID，與會員群組分離）
  papagoFaceId   String?   @unique
  faceEnrolledAt DateTime?
  /// 生物辨識電子同意（最近一次有效簽署；撤回時清空並刪除 Face8 特徵）；簽署證據見 StaffConsentSignature
  faceConsentAt        DateTime?
  faceConsentByStaffId Int?
  consentSignatures    StaffConsentSignature[]
  rosterOffRequests    RosterOffRequest[]
  rosterAcks           RosterAcknowledgement[]
  coachWeekPlans       CoachWeekPlan[]

  /// LINE 推播收件（員工本人以 LINE Login 自願綁定）；僅作通知，**禁止**用於登入或身分驗證
  lineUserId        String?   @unique
  lineDisplayName   String?
  lineBoundAt       DateTime?
  lineNotifyEnabled Boolean   @default(true)
  notifications     StaffNotification[]

  payProfile   StaffPayProfile?
  payrollItems PayrollItem[]

  /// 若此員工為教練，一對一綁定 Trainer 個人工作區
  trainerProfile Trainer?

  hqCompensationLogs HqCompensationLog[]
  staffAttendances StaffAttendance[]
  staffLeaves      StaffLeave[]
  staffSchedules   StaffSchedule[]
  memberNotes      MemberNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 總部合規補償異動日誌（append-only；運動金／效期／解鎖警示／補償課程）
model HqCompensationLog {
  id           String   @id // HCL…
  action       String   // BONUS | EXPIRE | CLEAR_ALERT | COURSE
  memberId     Int
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  actorStaffId Int
  actorStaff   Staff    @relation(fields: [actorStaffId], references: [id])
  /// BONUS：綁定的客訴補償 Promotion
  promotionId  Int?
  promotion    Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  /// COURSE：綁定的客訴補償 CoursePlan
  coursePlanId Int?
  coursePlan   CoursePlan? @relation(fields: [coursePlanId], references: [id], onDelete: SetNull)
  /// 客訴結案單號或原因（必填）
  reason       String
  detail       Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([memberId, createdAt])
  @@index([actorStaffId, createdAt])
  @@index([action, createdAt])
  @@index([coursePlanId])
}

/// 櫃檯交接班結算（錢櫃現金對帳）
model ShiftHandover {
  id              String   @id // SHF…
  branchId        Int
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  openedByStaffId Int
  openedByName    String
  closedByStaffId Int?
  closedByName    String?
  startedAt       DateTime
  endedAt         DateTime?
  /// OPEN | CLOSED
  status          String   @default("OPEN")
  /// MORNING | EVENING（早 07:00–15:30／晚 15:30–00:00）；MIDDAY 僅歷史相容
  slot            String?
  /// 開班錢櫃底金（預設沿用上一班實點）
  openingFloat    Float    @default(0)
  /// 系統應有現金＝底金＋班內現金收入
  expectedCash    Float?
  /// 交班實點現金
  countedCash     Float?
  /// counted − expected
  variance        Float?
  payMixSnapshot  Json?
  summarySnapshot Json?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([branchId, status])
  @@index([branchId, startedAt])
  @@index([branchId, slot, startedAt])
}

// ==========================================
// 8. CMS／內容（公告、FAQ、留言）
// ==========================================
model Announcement {
  id          Int      @id @default(autoincrement())
  branchId    Int?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  title       String
  body        String   @db.Text
  /// ACTIVITY | CLOSURE | GENERAL
  category    String   @default("GENERAL")
  pushEnabled Boolean  @default(false)
  publishedAt DateTime @default(now())
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, publishedAt])
  @@index([branchId, isActive])
}

model FaqItem {
  id        Int      @id @default(autoincrement())
  branchId  Int?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category  String   @default("GENERAL")
  question  String
  answer    String   @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([branchId, isActive, sortOrder])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  message   String   @db.Text
  /// NEW | READ | REPLIED
  status    String   @default("NEW")
  staffNote String?
  createdAt DateTime @default(now())
  repliedAt DateTime?

  @@index([status, createdAt])
}

// ==========================================
// 9. 會員群組、備註、黑名單
// ==========================================
model MemberGroup {
  id          Int      @id @default(autoincrement())
  branchId    Int?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())

  members MemberGroupMember[]

  @@index([branchId])
}

model MemberGroupMember {
  memberId Int
  groupId  Int
  member   Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  group    MemberGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([memberId, groupId])
}

model MemberNote {
  id        Int      @id @default(autoincrement())
  memberId  Int
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  staffId   Int?
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  content   String   @db.Text
  /// STAFF_ONLY | SHARED
  visibility String  @default("SHARED")
  createdAt DateTime @default(now())

  @@index([memberId, createdAt])
}

model PaymentBlacklist {
  id        Int      @id @default(autoincrement())
  memberId  Int      @unique
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reason    String
  note      String?
  staffId   Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  clearedAt DateTime?

  @@index([isActive])
}

// ==========================================
// 10. 課程請假、補課、簽到
// ==========================================
model ClassLeave {
  id             Int          @id @default(autoincrement())
  memberId       Int
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reservationId  Int          @unique
  reservation    Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  reason         String?
  /// PENDING | APPROVED | REJECTED
  status         String       @default("PENDING")
  /// 是否依規定請假（私教：上課 8 小時前；false → 計臨時請假補償金，不扣堂）
  withinPolicy   Boolean      @default(true)
  deductedSessions Int        @default(0)
  deductedPoints   Int        @default(0)
  /// 私教合約（臨時請假補償金歸屬；退費時自應退餘額扣除）
  ptContractId   Int?
  /// 契約第六條第五款：課程單價 20%（不足 100 以 100 計）
  compensationFee Int         @default(0)
  staffId        Int?
  createdAt      DateTime     @default(now())

  @@index([memberId, status])
  @@index([ptContractId])
}

model MakeupSlot {
  id          Int      @id @default(autoincrement())
  classId     Int
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  capacity    Int      @default(1)
  notifySent  Boolean  @default(false)
  createdAt   DateTime @default(now())

  registrations MakeupRegistration[]

  @@index([classId])
}

model MakeupRegistration {
  id            Int        @id @default(autoincrement())
  memberId      Int
  member        Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  makeupSlotId  Int
  makeupSlot    MakeupSlot @relation(fields: [makeupSlotId], references: [id], onDelete: Cascade)
  /// 原缺席預約 id（可空）
  originalReservationId Int?
  status        String     @default("REGISTERED")
  createdAt     DateTime   @default(now())

  @@unique([memberId, makeupSlotId])
  @@index([makeupSlotId])
}

model ClassCheckInToken {
  id        Int      @id @default(autoincrement())
  classId   Int
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  token     String   @unique
  /// PRIVATE_COACH | GROUP_VENUE
  kind      String   @default("GROUP_VENUE")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([classId, expiresAt])
}

model ClassAttendance {
  id             Int          @id @default(autoincrement())
  classId        Int
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  reservationId  Int          @unique
  reservation    Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  memberId       Int?
  member         Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  checkedInAt    DateTime     @default(now())
  /// QR | STAFF
  method         String       @default("QR")

  @@index([classId, checkedInAt])
}

// ==========================================
// 11. 訓練紀錄、場地預約、諮詢分配
// ==========================================
model TrainingRecord {
  id        Int      @id @default(autoincrement())
  memberId  Int
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainerId Int
  trainer   Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  title     String
  content   Json?
  sharedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId, createdAt])
  @@index([trainerId])
}

model SelfTrainingPlan {
  id        Int      @id @default(autoincrement())
  memberId  Int
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainerId Int?
  trainer   Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  title     String
  exercises Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
}

model VenueBooking {
  id        Int      @id @default(autoincrement())
  venueId   Int
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  stationId Int?
  memberId  Int?
  member    Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  trainerId Int?
  trainer   Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  startAt   DateTime
  endAt     DateTime
  status    String   @default("CONFIRMED")
  note      String?
  createdAt DateTime @default(now())

  @@index([venueId, startAt])
  @@index([trainerId, startAt])
}

model ConsultAllocation {
  id             Int          @id @default(autoincrement())
  consultGuestId Int
  consultGuest   ConsultGuest @relation(fields: [consultGuestId], references: [id], onDelete: Cascade)
  trainerId      Int
  /// AUTO | MANUAL
  assignMode     String       @default("MANUAL")
  staffId        Int?
  note           String?
  createdAt      DateTime     @default(now())

  @@index([consultGuestId])
  @@index([trainerId])
}

// ==========================================
// 12. 教練拆帳
// ==========================================
model CoachCommissionRule {
  id          Int      @id @default(autoincrement())
  trainerId   Int?
  trainer     Trainer? @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  /// PRIVATE | GROUP
  courseKind  String   @default("PRIVATE")
  /// 已停用：獎金組成由 tierRates／sessionBonus／perHeadRate 決定（lib/coachPerformance.js）
  payModel    String   @default("PERFORMANCE")
  /// 已停用：教練底薪一律於薪資設定（StaffPayProfile）維護，禁止於此重複
  baseSalary  Float    @default(0)
  /// 私教業績階梯抽成 JSON：[{ minRevenue, rate }]（達標級距之比例適用當月全部執行業績）
  tierRates   Json?
  /// 已停用：固定鐘點制（僅付上課鐘點）不符僱傭關係，改為 sessionBonus 另計
  hourlyRate  Float?
  /// 授課獎金（每堂；私教＝每執行堂、團課＝每開課堂）
  sessionBonus Float?
  /// 團課人頭獎金（每到課人次）
  perHeadRate Float?
  /// 已停用：刷卡手續費等營業成本不得轉嫁教練
  deductRates Json?
  /// 已停用
  scoreFactor Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([trainerId, courseKind])
}

model CoachCommissionLedger {
  id          String   @id // CCL...
  trainerId   Int
  trainer     Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  grossAmount Float
  deductions  Float    @default(0)
  netAmount   Float
  detail      Json?
  createdAt   DateTime @default(now())

  @@index([trainerId, periodStart])
}

// ==========================================
// 13. 員工考勤／請假／排班
// ==========================================
model StaffAttendance {
  id        Int      @id @default(autoincrement())
  staffId   Int
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branchId  Int?
  punchIn   DateTime
  punchOut  DateTime?
  note      String?
  createdAt DateTime @default(now())
  /// SELF 員工自助打卡 | HQ 總部補登
  source             String    @default("SELF")
  createdByStaffId   Int?
  /// 上班卡逾 16 小時未下班，已由下一次上班打卡結案，待更正
  missedPunchOut     Boolean   @default(false)
  correctedByStaffId Int?
  correctedAt        DateTime?
  correctionReason   String?
  /// 打卡綁定之值勤班次（自助上班打卡須落在已生效班表值勤窗；總部補登可選填）；班表重排刪列時置空，改回就近配對
  scheduleId         Int?
  schedule           StaffSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([staffId, punchIn])
  @@index([branchId, punchIn])
  @@index([scheduleId])
}

model StaffLeave {
  id        Int      @id @default(autoincrement())
  staffId   Int
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime
  /// lib/laborLaw.js LEAVE_TYPES；ANNUAL／NATIONAL_HOLIDAY 扣抵額度
  leaveType String   @default("OTHER")
  /// 請假時數（特休／國休以時數扣抵；1 日 = 8 小時）
  hours     Float?
  reason    String?
  proofUrl  String?
  /// PENDING | APPROVED | REJECTED | CANCELLED（已核准後撤銷，額度回補）
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  /// 總部代登者；null＝員工本人申請
  createdByStaffId  Int?
  reviewedByStaffId Int?
  reviewedAt        DateTime?
  /// 拒絕／撤銷必填
  reviewNote        String?

  @@index([staffId, status])
  @@index([staffId, leaveType, startAt])
}

/// 勞工國定假日曆（勞基法 §37；農曆節日逐年由 HQ 維護）
model PublicHoliday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())
}

model StaffSchedule {
  id        Int      @id @default(autoincrement())
  staffId   Int
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branchId  Int?
  startAt   DateTime
  endAt     DateTime
  /// SHIFT 出勤 | REGULAR_OFF 例假 | REST_DAY 休息日 | OFF 排休 | FREE 教練週班表出勤（轉正教練提報、店長核准）
  slotType  String   @default("SHIFT")
  note      String?
  createdAt DateTime @default(now())
  /// 總部指派之臨時排班：建立者（由 Staff JWT 取得）
  createdByStaffId Int?

  /// 四週變形排班（lib/shiftRoster.js）；null＝一般／自由排班
  rosterPeriodId Int?
  rosterPeriod   RosterPeriod? @relation(fields: [rosterPeriodId], references: [id], onDelete: Cascade)
  /// 排班日（台北日期）
  workDate       DateTime?     @db.Date
  /// MORNING | EVENING（slotType=SHIFT 時）
  shiftCode      String?

  /// 教練週班表（lib/coachSchedule.js）；僅 APPROVED 之班表生效
  coachPlanId    Int?
  coachPlan      CoachWeekPlan? @relation(fields: [coachPlanId], references: [id], onDelete: Cascade)

  attendances    StaffAttendance[]

  @@unique([rosterPeriodId, staffId, workDate])
  @@index([staffId, startAt])
  @@index([branchId, startAt])
  @@index([coachPlanId])
}

/// 轉正教練週班表（週一～週日）：教練提報出勤時段＋例假／休息日 → 店長以上核准才生效
/// 勞基法 §30／§34／§35／§36 檢查見 lib/coachSchedule.js；有 ERROR 禁止送審與核准
model CoachWeekPlan {
  id                Int       @id @default(autoincrement())
  staffId           Int
  staff             Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branchId          Int?
  /// 週一（台北日期）
  weekStart         DateTime  @db.Date
  /// DRAFT | SUBMITTED | APPROVED | REJECTED
  status            String    @default("DRAFT")
  regularOffDate    DateTime? @db.Date
  restDayDate       DateTime? @db.Date
  note              String?
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewedByStaffId Int?
  /// 退回／撤回核准之原因（必填）
  reviewNote        String?
  /// 審核歷程 [{ at, action, actorStaffId, reason? }]
  history           Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  slots StaffSchedule[]

  @@unique([staffId, weekStart])
  @@index([branchId, status, weekStart])
}

/// 分店四週變形排班設定：週期錨點（28 日固定起算）與每班場務最低人力（不得低於 2）
model BranchRosterConfig {
  branchId         Int      @id
  branch           Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cycleAnchorDate  DateTime @db.Date
  morningHeadcount Int      @default(2)
  eveningHeadcount Int      @default(2)
  updatedAt        DateTime @updatedAt
}

/// 四週（28 日）排班期；DRAFT 可編修／自動排班，PUBLISHED 須通過合規檢查
model RosterPeriod {
  id                 Int       @id @default(autoincrement())
  branchId           Int
  branch             Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  startDate          DateTime  @db.Date
  /// DRAFT | PUBLISHED
  status             String    @default("DRAFT")
  createdByStaffId   Int?
  publishedAt        DateTime?
  publishedByStaffId Int?
  note               String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  entries StaffSchedule[]
  acks    RosterAcknowledgement[]

  @@unique([branchId, startDate])
}

/// 員工班表確認回覆（發布後 72 小時內）；撤回重發會產生新版本，須重新確認
model RosterAcknowledgement {
  id                Int          @id @default(autoincrement())
  rosterPeriodId    Int
  rosterPeriod      RosterPeriod @relation(fields: [rosterPeriodId], references: [id], onDelete: Cascade)
  staffId           Int
  staff             Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  /// 回覆對應之發布版本（RosterPeriod.publishedAt）
  periodPublishedAt DateTime
  /// CONFIRMED | DISPUTED
  status            String
  message           String?
  /// 逾 72 小時未回覆由排程自動視為同意（respondedAt＝期限時間）
  autoConfirmed     Boolean      @default(false)
  respondedAt       DateTime     @default(now())

  @@unique([rosterPeriodId, staffId, periodPublishedAt])
}

/// 員工排假申請（每人每週期一筆；指定希望休假之日期），排班期發布後鎖定
model RosterOffRequest {
  id             Int        @id @default(autoincrement())
  branchId       Int
  branch         Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffId        Int
  staff          Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  cycleStartDate DateTime   @db.Date
  dates          DateTime[] @db.Date
  note           String?
  submittedAt    DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([branchId, staffId, cycleStartDate])
  @@index([branchId, cycleStartDate])
}

/// 員工通知匣＋LINE 推播佇列（lib/staffNotificationService.js）；推播失敗排程重試，站內仍可查看
model StaffNotification {
  id        Int       @id @default(autoincrement())
  staffId   Int
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  /// ROSTER_PUBLISHED | ROSTER_UNPUBLISHED | ROSTER_ACK_DISPUTED | ROSTER_ACK_REMINDER | ROSTER_AUTO_CONFIRMED |
  /// OFF_REQUEST_SUBMITTED | OFF_REQUEST_REMINDER | OFF_REQUEST_CLOSED | LEAVE_REQUESTED | LEAVE_REVIEWED | LEAVE_CONFLICT |
  /// PAYSLIP_READY | PAYSLIP_REOPENED | COACH_PLAN_SUBMITTED | COACH_PLAN_APPROVED | COACH_PLAN_REJECTED |
  /// COACH_PLAN_REOPENED | TEST
  type      String
  title     String
  body      String
  /// 前端相對路徑（如 /staff/my-roster）
  link      String?
  /// 同一事件同一收件人只發一次（type:...:staffId）
  dedupeKey String?   @unique
  /// PENDING | SENT | SKIPPED（未綁定／關閉／未設定 Token）| FAILED
  status    String    @default("PENDING")
  attempts  Int       @default(0)
  lastError String?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([staffId, createdAt])
  @@index([status, createdAt])
}

/// 工資核算匯出稽核紀錄
model PayrollExportLog {
  id                 Int      @id @default(autoincrement())
  month              String
  branchId           Int?
  staffCount         Int
  generatedByStaffId Int?
  createdAt          DateTime @default(now())

  @@index([month])
}

/// 員工薪資設定（lib/payrollService.js）；金額單位新臺幣元
model StaffPayProfile {
  staffId             Int      @id
  staff               Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  /// MONTHLY 月薪 | HOURLY 時薪
  payType             String   @default("MONTHLY")
  monthlySalary       Int?
  hourlyWage          Int?
  /// 固定津貼 [{ label, amount }]
  allowances          Json?
  /// 勞保投保薪資（null＝未投保）
  laborInsuredSalary  Int?
  /// 健保投保金額（null＝未於本公司投保）
  healthInsuredSalary Int?
  /// 健保眷屬人數（自付計費上限 3 口）
  healthDependents    Int      @default(0)
  /// 勞退月提繳工資（null＝不提繳）
  pensionWage         Int?
  /// 員工自提勞退比例 0～0.06
  pensionSelfRate     Float    @default(0)
  note                String?
  updatedByStaffId    Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// 薪資費率設定（單列 id=1；未設定之鍵沿用 lib/payrollRules.js 預設）
model PayrollConfig {
  id               Int      @id @default(1)
  rates            Json
  updatedByStaffId Int?
  updatedAt        DateTime @updatedAt
}

/// 月薪資結算批次（每月一批；FINALIZED 後員工可見薪資單，撤銷須附原因）
model PayrollRun {
  id                 Int           @id @default(autoincrement())
  month              String        @unique
  /// DRAFT | FINALIZED
  status             String        @default("DRAFT")
  /// 計算當下之費率快照
  config             Json
  warnings           Json?
  createdByStaffId   Int?
  calculatedAt       DateTime      @default(now())
  finalizedAt        DateTime?
  finalizedByStaffId Int?
  /// 結算／撤銷紀錄 [{ action, at, byStaffId, reason? }]
  history            Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  items              PayrollItem[]
}

/// 個人薪資單；lines 由後端計算（lib/payrollRules.js），overtime／adjustments 為總部核定與手動項
model PayrollItem {
  id             Int        @id @default(autoincrement())
  runId          Int
  run            PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  staffId        Int
  staff          Staff      @relation(fields: [staffId], references: [id])
  profile        Json
  facts          Json
  /// 加班建議與核定 [{ key, attendanceId, date, kind, suggestedMinutes, approvedMinutes|null, decidedByStaffId, decidedAt }]
  overtime       Json
  /// 手動項 [{ id, type, label, amount, note, byStaffId, at }]
  adjustments    Json
  lines          Json
  grossPay       Int        @default(0)
  deductionTotal Int        @default(0)
  netPay         Int        @default(0)
  employerCost   Int        @default(0)
  warnings       Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([runId, staffId])
  @@index([staffId])
}

// ==========================================
// 14. 行銷／CRM
// ==========================================
model MarketingCampaign {
  id          Int      @id @default(autoincrement())
  name        String
  /// DORMANT_BALANCE | DORMANT_VISIT | NO_RENEW | UNUSED_SESSIONS | POST_CONSULT
  segment     String
  message     String   @db.Text
  scheduledAt DateTime?
  sentAt      DateTime?
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())

  pushLogs PushCampaignLog[]

  @@index([status, scheduledAt])
}

model PushCampaignLog {
  id         Int               @id @default(autoincrement())
  campaignId Int
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  memberId   Int
  channel    String            @default("LINE")
  status     String            @default("SENT")
  sentAt     DateTime          @default(now())

  @@index([campaignId])
  @@index([memberId])
}

model ReferralOffer {
  id            Int      @id @default(autoincrement())
  name          String
  discountPct   Float?
  discountAmt   Float?
  referrerBonus Float?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model AddOnOffer {
  id          Int      @id @default(autoincrement())
  name        String
  productId   Int?
  price       Float
  minCartAmt  Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model MemberPointsLedger {
  id        Int      @id @default(autoincrement())
  memberId  Int
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  delta     Int
  balance   Int
  reason    String
  refType   String?
  refId     String?
  createdAt DateTime @default(now())

  @@index([memberId, createdAt])
}

model GiftCard {
  id           String   @id // GFC...
  purchaserId  Int?
  purchaser    Member?  @relation("GiftCardPurchaser", fields: [purchaserId], references: [id], onDelete: SetNull)
  redeemerId   Int?
  redeemer     Member?  @relation("GiftCardRedeemer", fields: [redeemerId], references: [id], onDelete: SetNull)
  amount       Float
  code         String   @unique
  status       String   @default("ACTIVE")
  expiresAt    DateTime?
  redeemedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([status])
}

model FamilyCard {
  id        Int      @id @default(autoincrement())
  name      String
  ownerId   Int
  promotionId Int?
  maxMembers Int     @default(4)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  members FamilyCardMember[]
}

model FamilyCardMember {
  familyCardId Int
  memberId     Int
  familyCard   FamilyCard @relation(fields: [familyCardId], references: [id], onDelete: Cascade)
  member       Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([familyCardId, memberId])
}

model LotteryPool {
  id        Int      @id @default(autoincrement())
  name      String
  drawAt    DateTime?
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  entries LotteryEntry[]
}

model LotteryEntry {
  id        Int         @id @default(autoincrement())
  poolId    Int
  pool      LotteryPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  memberId  Int
  member    Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  note      String?
  createdAt DateTime    @default(now())

  @@unique([poolId, memberId])
}

model InBodyVoucher {
  id        Int      @id @default(autoincrement())
  memberId  Int
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  code      String   @unique
  status    String   @default("ACTIVE")
  redeemedAt DateTime?
  createdAt DateTime @default(now())

  @@index([memberId, status])
}

model GoogleCalendarLink {
  id           Int      @id @default(autoincrement())
  trainerId    Int      @unique
  trainer      Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  calendarId   String?
  accessToken  String?  @db.Text
  refreshToken String?  @db.Text
  syncEnabled  Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

model NotificationLog {
  id        Int      @id @default(autoincrement())
  memberId  Int?
  member    Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  channel   String   // EMAIL | LINE | PUSH
  kind      String   // PAYMENT | REMINDER | BOOKING | INVOICE | CONTRACT
  subject   String?
  body      String?  @db.Text
  status    String   @default("SENT")
  createdAt DateTime @default(now())

  @@index([memberId, createdAt])
  @@index([kind, createdAt])
}

/// 乙禾端末成功暫存（confirm 前斷線 → 日結對帳）
model YipayTerminalCapture {
  id          String    @id // YCAP…
  /// ORDER | SALE | CHECKOUT
  targetType  String
  targetId    String
  amount      Float
  rrn         String?
  authCode    String?
  cardLast4   String?
  branchId    Int?
  staffId     Int?
  terminalRef String?
  /// PENDING_CONFIRM | CONFIRMED | ORPHAN | VOIDED
  status      String    @default("PENDING_CONFIRM")
  raw         Json?
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([rrn])
  @@index([branchId, createdAt])
}
