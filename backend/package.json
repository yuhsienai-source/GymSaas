{
  "name": "gymsaas",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "app.js",
  "scripts": {
    "start": "node --env-file=.env app.js",
    "dev": "node --env-file=.env --watch app.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "node --env-file=.env prisma/seed.js",
    "db:constraints": "node --env-file=.env prisma/applyGateConstraints.js",
    "db:studio": "prisma studio",
    "setup": "prisma generate && prisma db push && npm run db:constraints && node --env-file=.env prisma/seed.js",
    "check:syntax": "node --check app.js && find routes lib middleware -name '*.js' -print0 | xargs -0 -n1 node --check",
    "check:prisma": "prisma validate",
    "check:lint": "eslint .",
    "lint": "npm run check:lint",
    "doctor": "npm run check:prisma && npm run check:lint && npm run check:syntax",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "prisma": {
    "seed": "node --env-file=.env prisma/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.22.0",
    "sharp": "^0.35.4",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/config": "^7.8.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "prisma": "^7.9.0"
  }
}
